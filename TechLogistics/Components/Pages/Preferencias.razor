@page "/preferencias"
@rendermode InteractiveServer

@using TechLogistics.Services

@inject PreferenciasUsuarioService PreferenciasService

<PageTitle>Preferencias de Usuario</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="mb-1">Preferencias de Usuario</h2>

        <p class="text-muted mb-0">
            Prueba de almacenamiento protegido del navegador.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="mb-3">
                <label class="form-label">
                    Último centro seleccionado
                </label>

                <input class="form-control"
                       @bind="nombreCentro"
                       placeholder="Ej. Guatemala" />
            </div>

            <div class="d-flex gap-2">

                <button class="btn btn-dark"
                        @onclick="GuardarAsync">
                    Guardar
                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="CargarAsync">
                    Cargar
                </button>

                <button class="btn btn-outline-danger"
                        @onclick="EliminarAsync">
                    Eliminar
                </button>

            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert alert-light border mt-4">
                    @mensaje
                </div>
            }

        </div>
    </div>

</div>

@code {

    private string nombreCentro = string.Empty;

    private string? mensaje;

    private async Task GuardarAsync()
    {
        if (string.IsNullOrWhiteSpace(nombreCentro))
        {
            mensaje = "Ingrese un centro antes de guardar.";
            return;
        }

        await PreferenciasService.GuardarUltimoCentroAsync(
            nombreCentro);

        mensaje =
            $"Centro guardado correctamente: {nombreCentro}";
    }

    private async Task CargarAsync()
    {
        var centro =
            await PreferenciasService.ObtenerUltimoCentroAsync();

        if (string.IsNullOrWhiteSpace(centro))
        {
            mensaje = "No existe ningún centro guardado.";
            return;
        }

        nombreCentro = centro;

        mensaje =
            $"Centro recuperado correctamente: {centro}";
    }

    private async Task EliminarAsync()
    {
        await PreferenciasService.EliminarUltimoCentroAsync();

        nombreCentro = string.Empty;

        mensaje =
            "Preferencia eliminada correctamente.";
    }
}
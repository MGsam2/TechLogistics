@using TechLogistics.Models

<div class="col-12 col-md-6 col-lg-3">

    <div class="card shadow-sm centro-card">

        <div class="card-body centro-header"
             role="button"
             @onclick="SeleccionarCentro">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="card-title mb-0">
                    🏢 @Centro.Nombre
                </h5>

                @if (Centro.EnLinea)
                {
                    <span class="badge bg-success">
                        🟢 En línea
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        🟡 Advertencia
                    </span>
                }

            </div>

            <small class="text-muted">
                @(mostrarDetalles
                    ? "Haz clic para ocultar los detalles"
                    : "Haz clic para ver los detalles")
            </small>

        </div>

        @if (mostrarDetalles)
        {
            <div class="card-body border-top">

                <div class="detalle-centro">

                    <div>
                        <span>📦 Inventario</span>

                        <strong>
                            @Centro.Inventario.ToString("N0") unidades
                        </strong>
                    </div>

                    <div>
                        <span>Estado</span>

                        <strong>
                            @(Centro.EnLinea
                                ? "Operativo"
                                : "Requiere atención")
                        </strong>
                    </div>

                    <div>
                        <span>Última actualización</span>

                        <strong>
                            @Centro.UltimaActualizacion.ToLocalTime().ToString("HH:mm:ss")
                        </strong>
                    </div>

                </div>

            </div>
        }

    </div>

</div>


@code {

    private bool mostrarDetalles;

    [Parameter]
    [EditorRequired]
    public CentroDistribucion Centro { get; set; } = default!;

    [Parameter]
    public EventCallback<CentroDistribucion>
        OnCentroSeleccionado { get; set; }

    private async Task SeleccionarCentro()
    {
        // Mostrar u ocultar detalles
        mostrarDetalles = !mostrarDetalles;

        // Informar al Dashboard qué centro fue consultado
        await OnCentroSeleccionado.InvokeAsync(Centro);
    }

}
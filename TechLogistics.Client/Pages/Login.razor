@page "/login"

@using TechLogistics.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión - TechLogistics</PageTitle>

<div class="login-container">

    <div class="login-card">

        <div class="login-header">
            <div class="login-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <h1>TechLogistics</h1>
            <p>Gestión logística de inventarios</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="IniciarSesion">

            <DataAnnotationsValidator />

            <div class="form-group">
                <label>Usuario</label>

                <div class="input-container">
                    <i class="bi bi-person"></i>

                    <InputText
                        @bind-Value="modelo.NombreUsuario"
                        class="form-control"
                        placeholder="Ingrese su usuario" />
                </div>

                <ValidationMessage
                    For="@(() => modelo.NombreUsuario)" />
            </div>

            <div class="form-group">
                <label>Contraseña</label>

                <div class="input-container">
                    <i class="bi bi-lock"></i>

                    <InputText
                        @bind-Value="modelo.Password"
                        type="password"
                        class="form-control"
                        placeholder="Ingrese su contraseña" />
                </div>

                <ValidationMessage
                    For="@(() => modelo.Password)" />
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="login-error">
                    <i class="bi bi-exclamation-circle"></i>
                    @error
                </div>
            }

            <button
                type="submit"
                class="login-button"
                disabled="@cargando">

                @if (cargando)
                {
                    <span>Ingresando...</span>
                }
                else
                {
                    <span>Iniciar sesión</span>
                }
            </button>

        </EditForm>

    </div>

</div>

@code {

    private LoginRequest modelo = new();

    private string error = string.Empty;

    private bool cargando;

    private async Task IniciarSesion()
    {
        error = string.Empty;
        cargando = true;

        var resultado =
            await AuthProvider.LoginAsync(
                modelo.NombreUsuario,
                modelo.Password);

        cargando = false;

        if (!resultado)
        {
            error = "Usuario o contraseña incorrectos.";
            return;
        }

        Navigation.NavigateTo("/");
    }

    private class LoginRequest
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string NombreUsuario { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
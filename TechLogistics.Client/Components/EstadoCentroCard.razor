<div class="card h-100 shadow-sm">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-2">

            <h5 class="card-title mb-0">
                @Centro.NombreCentro
            </h5>

            @if (Centro.EnLinea)
            {
                <span class="badge bg-success">
                    En línea
                </span>
            }
            else
            {
                <span class="badge bg-warning text-dark">
                    Advertencia
                </span>
            }

        </div>

        <div class="mb-3">
            <small class="text-muted">
                Inventario total
            </small>

            <div class="fs-3 fw-bold">
                @Centro.InventarioTotal
            </div>
        </div>

        <div class="mb-3">
            <small class="text-muted">
                Última actualización
            </small>

            <div>
                @Centro.UltimaActualizacion
            </div>
        </div>

        <button class="btn btn-outline-secondary btn-sm"
                @onclick="SeleccionarCentro">

            Ver detalle

        </button>

    </div>

</div>

@code {

    [Parameter, EditorRequired]
    public TechLogistics.Grpc.InventarioActualizacion Centro { get; set; }
        = default!;

    [Parameter]
    public EventCallback<int> OnCentroSeleccionado { get; set; }

    private async Task SeleccionarCentro()
    {
        await OnCentroSeleccionado.InvokeAsync(
            Centro.CentroId);
    }
}
@page "/dashboard"
@rendermode InteractiveServer
@using TechLogistics.Models
@using TechLogistics.Services
@implements IDisposable
@inject CentroDistribucionService CentroService
@inject InventarioNotifier Notifier
@inject InventarioState InventarioState

<PageTitle>TechLogistics | Dashboard</PageTitle>

<!-- Encabezado -->
<div class="dashboard-header">

    <div>
        <h1>Panel de Monitoreo</h1>

        <p>
            Monitoreo en tiempo real de los centros de distribución.
        </p>
    </div>

    <div>
        <span class="badge bg-success">
            🟢 En tiempo real
        </span>
    </div>

</div>


<!-- Indicadores generales -->
<div class="row g-4 mb-4">

    <!-- Inventario total -->
    <div class="col-md-3">
        <div class="summary-card">

            <div class="summary-icon">
                📦
            </div>

            <div>
                <span class="summary-label">
                    Inventario total
                </span>

                <strong>
                    @InventarioTotal.ToString("N0")
                </strong>

                <small class="text-muted">
                    unidades disponibles
                </small>
            </div>

        </div>
    </div>


    <!-- Total de centros -->
    <div class="col-md-3">
        <div class="summary-card">

            <div class="summary-icon">
                🏢
            </div>

            <div>
                <span class="summary-label">
                    Centros
                </span>

                <strong>
                    @TotalCentros
                </strong>

                <small class="text-muted">
                    centros registrados
                </small>
            </div>

        </div>
    </div>


    <!-- Centros en línea -->
    <div class="col-md-3">
        <div class="summary-card">

            <div class="summary-icon">
                🟢
            </div>

            <div>
                <span class="summary-label">
                    En línea
                </span>

                <strong class="text-success">
                    @CentrosEnLinea
                </strong>

                <small class="text-muted">
                    centros operativos
                </small>
            </div>

        </div>
    </div>


    <!-- Centros en advertencia -->
    <div class="col-md-3">
        <div class="summary-card">

            <div class="summary-icon">
                🟡
            </div>

            <div>
                <span class="summary-label">
                    Advertencia
                </span>

                <strong class="text-warning">
                    @CentrosEnAdvertencia
                </strong>

                <small class="text-muted">
                    centros con problemas
                </small>
            </div>

        </div>
    </div>

</div>

<!-- Alertas de inventario -->
@if (CentrosCriticos > 0 || CentrosInventarioBajo > 0)
{
    <div class="alerts-section">

        <div class="section-header">

            <div>
                <h2>⚠ Alertas de inventario</h2>

                <p>
                    Centros que requieren atención.
                </p>
            </div>

            <span class="badge bg-warning text-dark">
                @TotalAlertas alertas
            </span>

        </div>

        <div class="row g-3">

            @if (CentrosCriticos > 0)
            {
                <div class="col-md-6">

                    <div class="alert alert-danger">

                        <strong>
                            🔴 Inventario crítico
                        </strong>

                        <span class="ms-2">
                            @CentrosCriticos centro(s)
                        </span>

                        <div class="small mt-1">
                            Inventario de 200 unidades o menos.
                        </div>

                    </div>

                </div>
            }

            @if (CentrosInventarioBajo > 0)
            {
                <div class="col-md-6">

                    <div class="alert alert-warning">

                        <strong>
                            🟠 Inventario bajo
                        </strong>

                        <span class="ms-2">
                            @CentrosInventarioBajo centro(s)
                        </span>

                        <div class="small mt-1">
                            Inventario entre 201 y 500 unidades.
                        </div>

                    </div>

                </div>
            }

        </div>

    </div>
}

<!-- Sección de centros -->
<div class="dashboard-section">

    <div class="section-header">

        <div>
            <h2>Centros de distribución</h2>

            <p>
                Estado actual del inventario y operación.
            </p>
        </div>

        <div class="last-update">

            <strong>Última actualización:</strong>

            @ultimaActualizacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")

        </div>

    </div>


    <!-- Centros -->
    <div class="row g-4">

        @foreach (var centro in centros)
        {
            <CentroCard Centro="centro" />
        }

    </div>

</div>

<!-- Inventario actualizado -->
@if (ultimoCentroActualizado is not null)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">

        <div>
            <strong>🔔 Inventario actualizado</strong>

            <div>
                @ultimoCentroActualizado
                —
                @ultimoInventarioActualizado?.ToString("N0")
                unidades
            </div>
        </div>

        <small>
            @horaUltimaNotificacion?.ToLocalTime().ToString("HH:mm:ss")
        </small>

    </div>
}

<!-- Información de actualización -->
<div class="alerts-section">

    <div class="section-header">

        <div>
            <h2>Sincronización</h2>

            <p>
                Estado de actualización del dashboard.
            </p>
        </div>

        <div>

            <span class="badge bg-success">
                🟢 Conectado
            </span>

        </div>

    </div>


    <div class="d-flex justify-content-between align-items-center">

        <div>

            <strong>
                Actualizaciones recibidas:
            </strong>

            <span class="ms-2">
                @actualizacionesRecibidas
            </span>

        </div>


        <button class="btn btn-primary"
                @onclick="Actualizar"
                disabled="@cargando">

            @if (cargando)
            {
                <span>Actualizando...</span>
            }
            else
            {
                <span>🔄 Actualizar ahora</span>
            }

        </button>

    </div>

</div>


@code {

    private DateTime ultimaActualizacion = DateTime.UtcNow;

    private List<CentroDistribucion> centros = new();

    private bool cargando;

    private int actualizacionesRecibidas;
    private string? ultimoCentroActualizado;
    private int? ultimoInventarioActualizado;
    private DateTime? horaUltimaNotificacion;


    // ==========================================
    // INDICADORES
    // ==========================================

    private int TotalCentros =>
        InventarioState.TotalCentros;

    private int CentrosEnLinea =>
        InventarioState.CentrosEnLinea;

    private int CentrosEnAdvertencia =>
        InventarioState.CentrosEnAdvertencia;

    private int InventarioTotal =>
        InventarioState.InventarioTotal;
    
    private int CentrosCriticos =>
    centros.Count(c => c.Inventario <= 200);

    private int CentrosInventarioBajo =>
        centros.Count(c =>
            c.Inventario > 200 &&
            c.Inventario <= 500);

    private int TotalAlertas =>
        CentrosCriticos + CentrosInventarioBajo;


    // ==========================================
    // INICIALIZACIÓN
    // ==========================================

    protected override async Task OnInitializedAsync()
    {
        Notifier.InventarioActualizado +=
            ActualizarDesdeNotificacion;

        InventarioState.PropertyChanged +=
            EstadoInventarioCambio;

        await CargarCentros();

        ultimaActualizacion = DateTime.UtcNow;
    }


    // ==========================================
    // ACTUALIZACIÓN EN TIEMPO REAL
    // ==========================================
    private async Task ActualizarDesdeNotificacion(
        InventarioActualizadoEvent evento)
    {
        await InvokeAsync(async () =>
        {
            await CargarCentros();

            ultimaActualizacion = DateTime.UtcNow;

            actualizacionesRecibidas++;

            StateHasChanged();
        });
    }

    // ==========================================
    // ESTADO INVENTARIO CAMBIO
    // ==========================================

    private async void EstadoInventarioCambio(
    object? sender,
    System.ComponentModel.PropertyChangedEventArgs e)
{
    await InvokeAsync(() =>
    {
        StateHasChanged();
    });
}

    // ==========================================
    // ACTUALIZACIÓN MANUAL
    // ==========================================

    private async Task Actualizar()
    {
        if (cargando)
            return;

        try
        {
            cargando = true;

            await CentroService.ActualizarInventarioAsync();
        }
        finally
        {
            cargando = false;
        }
    }

    // ==========================================
    // CONSULTAR BASE DE DATOS
    // ==========================================

    private async Task CargarCentros()
    {
        centros =
            await CentroService.ObtenerCentrosAsync();

        InventarioState.ActualizarCentros(centros);
    }


    // ==========================================
    // LIBERAR RECURSOS
    // ==========================================

    public void Dispose()
    {
        Notifier.InventarioActualizado -=
            ActualizarDesdeNotificacion;

        InventarioState.PropertyChanged -=
            EstadoInventarioCambio;
    }

}
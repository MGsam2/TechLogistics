@page "/dashboard"
@rendermode InteractiveServer
@using TechLogistics.Models
@using TechLogistics.Services
@inject CentroDistribucionService CentroService


<PageTitle>TechLogistics | Dashboard</PageTitle>

<h1>Panel de Monitoreo</h1>

<p>
    Monitoreo en tiempo real de los centros de distribución.
</p>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <strong>Última actualización:</strong>
        @ultimaActualizacion.ToString("dd/MM/yyyy HH:mm:ss")
    </div>

    <button class="btn btn-primary" @onclick="Actualizar">
        🔄 Actualizar
    </button>
</div>

<div class="row g-4">

    @foreach (var centro in centros)
    {
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h5 class="card-title">@centro.Nombre</h5>

                    <p class="card-text">
                        Inventario:
                        <strong>@centro.Inventario:N0</strong> unidades
                    </p>

                    @if (centro.EnLinea)
                    {
                        <span class="badge bg-success">
                            En línea
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Advertencia
                        </span>
                    }

                </div>
            </div>
        </div>
    }

</div>

@code {

    private DateTime ultimaActualizacion = DateTime.UtcNow;

    private List<CentroDistribucion> centros = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarCentros();
    }

    private async Task Actualizar()
    {
        await CentroService.ActualizarInventarioAsync();
        await CargarCentros();

        ultimaActualizacion = DateTime.UtcNow;
    }

    private async Task CargarCentros()
    {
        centros = await CentroService.ObtenerCentrosAsync();
    }
}